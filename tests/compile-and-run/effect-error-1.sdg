let funcs4: [Fn(Int) -> Int] = [pure_func, ndet_func];
let funcs6: [Fn(Int) -> Int] = [ndet_func, ndet_func];
let funcs7: [NdetFn(Int) -> Int] = [pure_func, ndet_func];
let funcs8: [NdetFn(Int) -> Int] = [pure_func, pure_func];
let lambda3: NdetFn(Int) -> Int = \(n) => n + 1;
