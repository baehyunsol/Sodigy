fn pure_func(n: Int) -> Int = n + 1;
ndet fn ndet_func(n: Int) -> Int = random_int() + n;
ndet proc ndet_proc(n: Int) -> Int = {
    do sleep(0.1);
    n + random_int()
};

let f3: NdetFn(Int) -> Int = pure_func;
let f4: NdetProc(Int) -> Int = pure_func;
let f6: Fn(Int) -> Int = ndet_func;
