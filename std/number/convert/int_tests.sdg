use std.int.Int;

#[name("std.number-int-test-0")]
assert -0.7 as <Int> == 0;
#[name("std.number-int-test-1")]
assert -0.5 as <Int> == 0;
#[name("std.number-int-test-2")]
assert -0.3 as <Int> == 0;
#[name("std.number-int-test-3")]
assert 0 as <Int> == 0;
#[name("std.number-int-test-4")]
assert 0.3 as <Int> == 0;
#[name("std.number-int-test-5")]
assert 0.5 as <Int> == 0;
#[name("std.number-int-test-6")]
assert 0.7 as <Int> == 0;
#[name("std.number-int-test-7")]
assert -1.7 as <Int> == -1;
#[name("std.number-int-test-8")]
assert -1.5 as <Int> == -1;
#[name("std.number-int-test-9")]
assert -1.3 as <Int> == -1;
#[name("std.number-int-test-10")]
assert 1.3 as <Int> == 1;
#[name("std.number-int-test-11")]
assert 1.5 as <Int> == 1;
#[name("std.number-int-test-12")]
assert 1.7 as <Int> == 1;
#[name("std.number-int-test-13")]
assert -2.7 as <Int> == -2;
#[name("std.number-int-test-14")]
assert -2.5 as <Int> == -2;
#[name("std.number-int-test-15")]
assert -2.3 as <Int> == -2;
#[name("std.number-int-test-16")]
assert 2.3 as <Int> == 2;
#[name("std.number-int-test-17")]
assert 2.5 as <Int> == 2;
#[name("std.number-int-test-18")]
assert 2.7 as <Int> == 2;
#[name("std.number-int-test-19")]
assert -3.7 as <Int> == -3;
#[name("std.number-int-test-20")]
assert -3.5 as <Int> == -3;
#[name("std.number-int-test-21")]
assert -3.3 as <Int> == -3;
#[name("std.number-int-test-22")]
assert 3.3 as <Int> == 3;
#[name("std.number-int-test-23")]
assert 3.5 as <Int> == 3;
#[name("std.number-int-test-24")]
assert 3.7 as <Int> == 3;
#[name("std.number-int-test-25")]
assert -4.7 as <Int> == -4;
#[name("std.number-int-test-26")]
assert -4.5 as <Int> == -4;
#[name("std.number-int-test-27")]
assert -4.3 as <Int> == -4;
#[name("std.number-int-test-28")]
assert 4.3 as <Int> == 4;
#[name("std.number-int-test-29")]
assert 4.5 as <Int> == 4;
#[name("std.number-int-test-30")]
assert 4.7 as <Int> == 4;
#[name("std.number-int-test-31")]
assert -5.7 as <Int> == -5;
#[name("std.number-int-test-32")]
assert -5.5 as <Int> == -5;
#[name("std.number-int-test-33")]
assert -5.3 as <Int> == -5;
#[name("std.number-int-test-34")]
assert 5.3 as <Int> == 5;
#[name("std.number-int-test-35")]
assert 5.5 as <Int> == 5;
#[name("std.number-int-test-36")]
assert 5.7 as <Int> == 5;

