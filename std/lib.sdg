use std.int.Int;
use std.string.String;

#[built_in]
#[lang_item("built_in.exit")]
proc exit_built_in(status_code: scalar.Scalar) -> !;

proc exit(status_code: Int) -> ! = match status_code {
    0..=255 => exit_built_in(status_code as! <scalar.Scalar>),
    _ => panic(f"Cannot exit with status code {status_code}. The status code must be in range 0..=255."),
};

// It's supposed to be `proc`, but I want to allow users
// to panic at any place, for debug purposes.
pub fn panic(s: String) -> ! = {
    // I can't use `std.io.debug` because `panic` is more serious than `std.io.debug`.
    // I can't use `std.io.eprint` because that's ndet-proc.
    // So I'm just using a compiler-magic.
    let debug: std.r#fn.Fn(String) -> Void = transmute(std.io.eprint);

    // The same compiler magic for panic.
    let panic: std.r#fn.Fn(Int) -> ! = transmute(exit);

    blackbox((debug(s ++ "\n"), panic(22)))._1
};

// TODO: It must be hidden to the users.
// This is a magic function. It does nothing at runtime.
// It exists just to trick the type checker. It's used for
// trivial type conversions (e.g. `Char` -> `Scalar`).
fn transmute<T, U>(v: T) -> U = nop1(v);

#[built_in]
#[lang_item("built_in.nop0")]
fn nop0() -> Void;

#[built_in]
#[lang_item("built_in.nop1")]
fn nop1<T, U>(v: T) -> U;

/// The compiler will never optimize-away this function.
// NOTE: There's no optimization, so it's just an id function.
// This is a compiler-magic. Use this when you want to use `proc` inside a pure function.
fn blackbox<T>(x: T) -> T = x;

#[built_in]
enum Void;
