#[name("mul-test-0")]
assert 3 * 0 == 0;
#[name("mul-test-1")]
assert -1 * -2 == 2;
#[name("mul-test-2")]
assert 3 * 5 == 15;

#[name("mul-test-3")]
assert 1_414_213_562_373_095_048_801_688_724_209 * 1_414_213_562_373_095_048_801_688_724_209 == 1999999999999999999999999999998025535638336044587854062675681;
#[name("mul-test-4")]
assert 1_732_050_807_568_877_293_527_446_341_505 * 1_732_050_807_568_877_293_527_446_341_505 == 2999999999999999999999999999996978032264435535097009085665025;
#[name("mul-test-5")]
assert 3_162_277_660_168_379_331_998_893_544_432 * 3_162_277_660_168_379_331_998_893_544_432 == 9999999999999999999999999999995455593741146183091923958202624;

#[name("mul-test-6")]
assert 0xffff_ffff_ffff_ffff_ffff_ffff_ffff_ffff_ffff_ffff_ffff_ffff * 0xffff_ffff_ffff_ffff_ffff_ffff_ffff_ffff_ffff_ffff_ffff_ffff == 39402006196394479212279040100143613805079739270465446667935739200774948409969539032567850922052710929917699921281025;

#[name("rem-test-0")]
assert 10 % 3 == 1;
#[name("rem-test-1")]
assert 10 % -3 == 1;
#[name("rem-test-2")]
assert -10 % 3 == -1;
#[name("rem-test-3")]
assert -10 % -3 == -1;

#[name("rem-test-4")]
assert 10 / 3 == 3;
#[name("rem-test-5")]
assert 10 / -3 == -3;
#[name("rem-test-6")]
assert -10 / 3 == -3;
#[name("rem-test-7")]
assert -10 / -3 == 3;