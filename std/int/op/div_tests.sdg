#[name("std.div-test-0")]
assert                                                              10 / 3                                == 3;
#[name("std.div-test-1")]
assert                                                           1_000 / 3_1                              == 32;
#[name("std.div-test-2")]
assert                                                         100_000 / 3_16                             == 3_16;
