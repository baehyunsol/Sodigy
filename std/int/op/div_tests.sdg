#[name("std.div-test-14")]
assert                         100_000_000_000_000_000_000_000_000_000 / 3_162_277_660_168_37             == 3_162_277_660_168_38;
#[name("std.div-test-15")]
assert                      10_000_000_000_000_000_000_000_000_000_000 / 3_162_277_660_168_379            == 3_162_277_660_168_379;
