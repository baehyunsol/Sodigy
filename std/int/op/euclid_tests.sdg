fn assert_euclid(a, b) = {
    let q = a / b;
    let r = a % b;

    q * b + r == a
};

#[name("euclid-test-0-0")]
assert assert_euclid(17, 5);
#[name("euclid-test-0-1")]
assert assert_euclid(-17, 5);
#[name("euclid-test-0-2")]
assert assert_euclid(17, -5);
#[name("euclid-test-0-3")]
assert assert_euclid(-17, -5);

#[name("euclid-test-1-0")]
assert assert_euclid(5, 3);
#[name("euclid-test-1-1")]
assert assert_euclid(-5, 3);
#[name("euclid-test-1-2")]
assert assert_euclid(5, -3);
#[name("euclid-test-1-3")]
assert assert_euclid(-5, -3);

#[name("euclid-test-2-0")]
assert assert_euclid(10, 3);
#[name("euclid-test-2-1")]
assert assert_euclid(-10, 3);
#[name("euclid-test-2-2")]
assert assert_euclid(10, -3);
#[name("euclid-test-2-3")]
assert assert_euclid(-10, -3);

#[name("euclid-test-3-0")]
assert assert_euclid(10, 2);
#[name("euclid-test-3-1")]
assert assert_euclid(-10, 2);
#[name("euclid-test-3-2")]
assert assert_euclid(10, -2);
#[name("euclid-test-3-3")]
assert assert_euclid(-10, -2);

#[name("euclid-test-4-0")]
assert assert_euclid(10, 1);
#[name("euclid-test-4-1")]
assert assert_euclid(-10, 1);
#[name("euclid-test-4-2")]
assert assert_euclid(10, -1);
#[name("euclid-test-4-3")]
assert assert_euclid(-10, -1);

#[name("euclid-test-5-0")]
assert assert_euclid(0, 2);
#[name("euclid-test-5-1")]
assert assert_euclid(-0, 2);
#[name("euclid-test-5-2")]
assert assert_euclid(0, -2);
#[name("euclid-test-5-3")]
assert assert_euclid(-0, -2);

#[name("euclid-test-6-0")]
assert assert_euclid(0, 1);
#[name("euclid-test-6-1")]
assert assert_euclid(-0, 1);
#[name("euclid-test-6-2")]
assert assert_euclid(0, -1);
#[name("euclid-test-6-3")]
assert assert_euclid(-0, -1);
