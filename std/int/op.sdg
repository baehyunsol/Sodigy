use std.int.Int;
use std.scalar.Scalar;

// I wanted `fn neg_int(x) = x * -1;`... but that's an infinite recursion!
#[built_in]
#[impl(std.op.neg)]
#[lang_item("built_in.neg_int")]
fn neg_int(a: Int) -> Int;

#[built_in]
#[impl(std.op.add)]
#[lang_item("built_in.add_int")]
fn add_int(a: Int, b: Int) -> Int;

#[built_in]
#[impl(std.op.sub)]
#[lang_item("built_in.sub_int")]
fn sub_int(a: Int, b: Int) -> Int;

#[built_in]
#[impl(std.op.mul)]
#[lang_item("built_in.mul_int")]
fn mul_int(a: Int, b: Int) -> Int;

/// It doesn't check whether `b` is 0 or not.
/// If `b` is 0, something bad (can be worse than `panic`) will happen.
#[built_in]
#[lang_item("built_in.div_int")]
fn div_int_built_in(a: Int, b: Int) -> Int;

#[impl(std.op.div)]
fn div_int(a: Int, b: Int) -> Int = {
    #[always]
    #[note(f"zero division: {a} / {b}")]
    assert b != 0;

    div_int_built_in(a, b)
};

#[built_in]
#[lang_item("built_in.rem_int")]
fn rem_int_built_in(a: Int, b: Int) -> Int;

#[impl(std.op.rem)]
fn rem_int(a: Int, b: Int) -> Int = {
    #[always]
    #[note(f"zero division: {a} % {b}")]
    assert b != 0;

    rem_int_built_in(a, b)
};

#[built_in]
#[impl(std.op.bit_and)]
#[lang_item("built_in.bit_and_int")]
fn bit_and_int(a: Int, b: Int) -> Int;

#[built_in]
#[impl(std.op.bit_or)]
#[lang_item("built_in.bit_or_int")]
fn bit_or_int(a: Int, b: Int) -> Int;

#[built_in]
#[lang_item("built_in.shr_int")]
fn shr_int_built_in(a: Int, b: Scalar) -> Int;

#[impl(std.op.shr)]
#[lang_item("fn.shr_int")]
fn shr_int(a: Int, b: Int) -> Int = match (a, b) {
    (..0, _) => -shr_int(-a, b),
    (_, ..0) => shl_int(a, -b),
    (_, 65536..) => 0,
    _ => shr_int_built_in(a, b as! <Scalar>),
};

#[built_in]
#[lang_item("built_in.shl_int")]
fn shl_int_built_in(a: Int, b: Scalar) -> Int;

#[impl(std.op.shl)]
#[lang_item("fn.shl_int")]
fn shl_int(a: Int, b: Int) -> Int = match (a, b) {
    (..0, _) => -shl_int(-a, b),
    (_, ..0) => shr_int(a, -b),
    (1.., 65536..) => std.panic("Integer Overflow"),
    _ => shl_int_built_in(a, b as! <Scalar>),
};
