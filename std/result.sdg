use std.bool.{Bool, Bool.False, Bool.True};
use std.r#fn.Fn;

enum Result<T, E> = {
    Ok(T),
    Error(E),
};

#[associate(Result<T, E>)]
fn unwrap<T, E>(self) -> T = match self {
    Result.Ok($v) => v,
    Result.Error($e) => std.panic(f"attempt to unwrap {e}"),
};

#[associate(Result<T, E>)]
fn is_ok<T, E>(self) -> Bool = match self {
    Result.Ok(_) => True,
    Result.Error(_) => False,
};

#[associate(Result<T, E>)]
fn is_error<T, E>(self) -> Bool = match self {
    Result.Ok(_) => False,
    Result.Error(_) => True,
};

#[impl(std.op.eq)]
fn eq_result<T, E>(a: Result<T, E>, b: Result<T, E>) -> Bool = match (a, b) {
    (Result.Ok($a), Result.Ok($b)) => a == b,
    (Result.Error($a), Result.Error($b)) => a == b,
    _ => False,
};

#[associate(Result<T, E>)]
fn map<T, E, U>(self, f: Fn(T) -> U) -> Result<U, E> = match self {
    Result.Ok($v) => Result.Ok(f(v)),
    Result.Error($e) => Result.Error(e),
};
