use std.{Void, blackbox};
use std.bool.{Bool, Bool.False};
use std.int.Int;
use std.scalar.Scalar;
use std.string.String;

// TODO: I have to implement ZST and Void.
//       Then all the functions here have to return Void.

#[built_in]
#[lang_item("built_in.print")]
ndet proc print(v: String) -> Void;

#[built_in]
#[lang_item("built_in.eprint")]
ndet proc eprint(v: String) -> Void;

#[built_in]
#[lang_item("built_in.debug")]
fn debug_built_in(v: String) -> Void;

// This is a debug-only function. Don't use this for actual printing!
fn debug<T>(
    v: T,
    prefix: String = "",
    suffix: String = "\n",
) -> T = {
    // The `do` keyword exists exactly for this purpose, but we can't use it
    // because we're in a pure context...
    blackbox((
        debug_built_in(prefix),
        debug_built_in(v as <String>),
        debug_built_in(suffix),
        v,
    ))._3
};
