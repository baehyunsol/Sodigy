use std.bool.Bool.{False, True};
use std.option.Option.{None, Some};
use std.range.Range;

mod cmp;
mod convert;
mod func;
mod op;

#[built_in]
#[lang_item("type.Int")]
pub enum Int;

#[impl(std.op.exclusive_range)]
fn exclusive_range_int(lhs: Int, rhs: Int) -> Range<Int> = Range {
    start: Some(lhs),
    start_inclusive: True,
    end: Some(rhs),
    end_inclusive: False,
    step: 1,
};

#[impl(std.op.inclusive_range)]
fn inclusive_range_int(lhs: Int, rhs: Int) -> Range<Int> = Range {
    start: Some(lhs),
    start_inclusive: True,
    end: Some(rhs),
    end_inclusive: True,
    step: 1,
};

#[impl(std.op.exclusive_pre_range)]
fn exclusive_pre_range_int(rhs: Int) -> Range<Int> = Range {
    start: None,
    start_inclusive: False,
    end: Some(rhs),
    end_inclusive: False,
    step: 1,
};

#[impl(std.op.exclusive_post_range)]
fn exclusive_post_range_int(lhs: Int) -> Range<Int> = Range {
    start: Some(lhs),
    start_inclusive: True,
    end: None,
    end_inclusive: False,
    step: 1,
};
