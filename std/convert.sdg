use std.result.Result;
use std.string.String;
use std.r#type.type_name;

struct ConversionError<T> = {
    value: T,
//    source_type: String,
//    target_type: String,
};

fn conversion_error<From, To>(value: From) -> ConversionError<From> = ConversionError {
    // TODO: impl shorthand
    value: value,

//    source_type: type_name.<From>(),
//    target_type: type_name.<To>(),
};

#[impl(convert)]
fn conversion_error_to_string<T>(e: ConversionError<T>) -> String = f"ConversionError {{ value: {e.value} }}";

#[poly]
#[lang_item("fn.convert")]
#[lang_item_generics("fn.convert.generic.0", "fn.convert.generic.1")]
fn convert<T, U>(x: T) -> U;

#[poly]
#[lang_item("fn.try_convert")]
#[lang_item_generics("fn.try_convert.generic.0", "fn.try_convert.generic.1", "fn.try_convert.generic.2")]
fn try_convert<T, U, E>(x: T) -> Result<U, E>;

#[impl(convert)]
fn convert_self<T>(x: T) -> T = x;

